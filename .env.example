# Your WhatsApp phone number in international format, digits only (no +, spaces or dashes).
# Must be the same account you link the bot to. Example for India: 919876543210
OWNER_PHONE=your_number

# Prefix for bot commands
COMMAND_PREFIX=!

# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# When true, removal operations are previewed and confirmed but nobody is removed.
DRY_RUN=false

# How to link the account on first start: qr | pairing
AUTH_METHOD=qr

# Local directories (both are git-ignored)
AUTH_DIR=./auth
LOG_DIR=./logs
# Stores only message ids/timestamps per group (needed to delete chats). No message content.
DATA_DIR=./data

# Seconds a removal preview stays valid before CONFIRM is rejected
CONFIRM_TTL_SECONDS=120

# Removal pacing
REMOVE_BATCH_SIZE=5
REMOVE_BATCH_DELAY_MS=3000

# Timeout for a single WhatsApp request
OPERATION_TIMEOUT_MS=30000
